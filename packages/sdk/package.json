{
  "name": "@cendor/sdk",
  "version": "0.9.1",
  "description": "Build an LLM agent with spending limits, a tamper-evident audit trail, PII redaction, and record/replay testing built in from the start — a governed agent in about 10 lines.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "INTEGRATION.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@cendor/acttrace": "^0.5.2",
    "@cendor/cassette": "^0.2.6",
    "@cendor/contextkit": "^1.0.6",
    "@cendor/core": "^0.5.0",
    "@cendor/guardrails": "^0.6.0",
    "@cendor/squeeze": "^0.2.6",
    "@cendor/tokenguard": "^0.2.6",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.11.1"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.30",
    "@modelcontextprotocol/sdk": ">=1",
    "@opentelemetry/api": ">=1",
    "openai": ">=4"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "keywords": [
    "llm",
    "agent",
    "openai",
    "anthropic",
    "governance",
    "cendor",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cendorhq/cendor-sdk-js.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://cendor.ai/docs/sdk/getting-started",
  "bugs": {
    "url": "https://github.com/cendorhq/cendor-sdk-js/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
