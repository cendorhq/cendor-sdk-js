{
  "name": "@cendor/sdk",
  "version": "0.3.0",
  "description": "A governed agent in ~10 lines — governance (budgets, tamper-evident audit, PII redaction, record/replay) is the foundation, not a plugin. The TypeScript port of cendor-sdk.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@cendor/acttrace": "^0.3.0",
    "@cendor/cassette": "^0.2.1",
    "@cendor/contextkit": "^1.0.1",
    "@cendor/core": "^0.3.0",
    "@cendor/squeeze": "^0.2.1",
    "@cendor/tokenguard": "^0.2.1",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.11.1"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.30",
    "@modelcontextprotocol/sdk": ">=1",
    "@opentelemetry/api": ">=1",
    "openai": ">=4"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "keywords": [
    "llm",
    "agent",
    "openai",
    "anthropic",
    "governance",
    "cendor",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cendorhq/cendor-sdk-js.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public"
  }
}
