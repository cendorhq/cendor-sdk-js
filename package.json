{
  "name": "cendor-sdk-js",
  "version": "0.0.0",
  "private": true,
  "description": "A governed agent in ~10 lines — the TypeScript port of cendor-sdk.",
  "type": "module",
  "packageManager": "pnpm@9.14.2",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean && rimraf packages/*/dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "check:docs": "node scripts/check-docs-snippets.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@biomejs/biome": "2.5.2",
    "@changesets/cli": "^2.27.11",
    "@google/genai": "^2.10.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.0",
    "better-sqlite3": "^12.11.1",
    "ollama": "^0.6.3",
    "openai": "^6.45.0",
    "rimraf": "^6.0.1",
    "typescript": "^6.0.3",
    "undici": "^8.7.0",
    "vitest": "^4.1.10"
  },
  "license": "Apache-2.0"
}
